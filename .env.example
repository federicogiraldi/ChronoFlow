# Copia questo file in .env (oppure imposta le variabili nel pannello dell'hosting)

# Porta del server locale
PORT=3000
# Interfaccia di rete: lascia commentato per accettare connessioni da questo PC e dalla rete di casa
# HOST=127.0.0.1

# Database. Vuoto = file locale backend/chronoflow.db
# In produzione con Turso: DATABASE_URL=libsql://<nome-db>-<utente>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Password per accedere all'app. Vuota = nessun login (solo per uso locale!)
APP_PASSWORD=
# Chiave per firmare il cookie di sessione (stringa casuale lunga, es. `openssl rand -hex 32`)
SESSION_SECRET=
# Durata della sessione in giorni
SESSION_DAYS=30

# production attiva cookie Secure, HSTS e upgrade a https
NODE_ENV=development

# ---------- Notifiche push (arrivano anche con l'app chiusa) ----------
# Genera le chiavi con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:la-tua-email@example.com
# Chiave segreta per il servizio esterno che ogni minuto chiama /api/cron/notify
# (serve solo online; genera un valore con: npm run secret)
CRON_SECRET=
# Fuso orario per calcolare l'orario delle notifiche (online di default Europe/Rome)
APP_TIMEZONE=
